import re


# função que formata o log para analise mais facil
format_pat = re.compile(
    r'(?P<host>[\d\.]+)\s'
    r'(?P<identity>\S*)\s'
    r'(?P<user>\S*)\s'
    r'\[(?P<time>.*?)\]\s'
    r'"(?P<request>.*?)"\s'
    r'(?P<status>\d+)\s'
    r'(?P<bytes>\S*)\s'
    r'"(?P<referer>.*?)"\s'
    r'"(?P<user_agent>.*?)"\s*'
)


# caminho do arquivo de log
logPath = "Codigos/access_log.txt"


# dicionario para armazenar as contagens de URL
URLCounts = {}

# abre o arquivo
with open (logPath, 'r') as f:

    # processa cada linha, removendo espaços em branco ou \n
    for line in (l.rstrip() for l in f):

        # tenta aplicar o match de cada linha do log
        # retorna o resultado da correspondência
        match = format_pat.match(line)

        # se retornou alguma coisa
        if match:

            # pega os dados nomeados em um dicionario
            access = match.groupdict()
            # pega a requisicao
            request = access['request']

            # separa a requisicao em campos
            (action, URL, protocol) = request.split()
            if URL in URLCounts:
                URLCounts[URL] += 1
            else:
                URLCounts[URL] = 1

# ordena os resultados pela contagem
results = sorted(URLCounts, key=lambda i: int(URLCounts[i]), reverse=True)

# mostra os 20 mais acessados
for result in results[:20]:
    print (result + ": " + str(URLCounts[result]))



